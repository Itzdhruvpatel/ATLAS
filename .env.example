# Copy to .env for local eval runs. Real values never go in git.
ATLAS_LLM_API_KEY=

# Arena server. Leave ATLAS_ARENA_MODEL unset to use the scripted demo model, which needs no key.
ATLAS_ARENA_MODEL=
ATLAS_ARENA_URL=https://openrouter.ai/api/v1
ATLAS_ARENA_KEY=
ATLAS_ADMIN_KEY=
ATLAS_VISITOR_SALT=
ATLAS_ROUNDS_PER_HOUR=10
ATLAS_CALLS_PER_DAY=500
ATLAS_DB=/data/arena.db
# Set to 1 only behind a proxy you control, otherwise visitors can fake their address.
ATLAS_TRUST_PROXY=

# Gateway
ATLAS_GATEWAY_KEY=
ATLAS_UPSTREAM_URL=https://openrouter.ai/api/v1
ATLAS_UPSTREAM_KEY=
ATLAS_CANARY_KEY=
